text = "暂停动画"

[node name="Speed" type="OptionButton" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"

[node name="Skip" type="Button" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"
text = "跳过动画"

[node name="Opponent" parent="." instance=ExtResource("hero")]
