[gd_scene load_steps=6 format=3]

[ext_resource type="Theme" path="res://Client/Godot/GameTheme.tres" id="theme"]
[ext_resource type="Script" path="res://Client/Godot/LaneDrop.cs" id="drop"]
[ext_resource type="PackedScene" path="res://Client/Godot/Scenes/HeroPanel.tscn" id="hero"]
[ext_resource type="PackedScene" path="res://Client/Godot/Scenes/SpellPlans.tscn" id="spells"]
[ext_resource type="PackedScene" path="res://Client/Godot/Scenes/BattleAnimations.tscn" id="animations"]

[node name="BattleScreen" type="Control"]
layout_mode = 3
custom_minimum_size = Vector2(1600, 1000)
size_flags_vertical = 3
theme = ExtResource("theme")

; 布局契约见 Docs/UIGuideline.zh-CN.md。四条横带，每条只做一件事：
;   8..58    工具栏   — 返回、对局信息、倒计时、AI 状态、全部次要按钮（小号）
;   68..620  主战区   — 左栏（双方英雄 + 费用）、六路战场、右侧卡牌详情
;   630..694 决策区   — 提交回合（最大按钮）、全局法术、已规划队列
;   702..996 手牌区   — 手牌（最大最亮）与底部一行提示
; 六路外侧宽 176（含 6px 内边距，槽位净宽 164）+ 间距 8，六路共 1096，
; 与战场宽度完全相等：六路全部可见，不需要横向滚动（12 路时才会出现滚动条）。
; 手牌区高度 268 故意高出卡牌 248，保证出现横向滚动条时卡牌仍不被裁切。

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 8.0
offset_right = 1580.0
offset_bottom = 58.0
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"
text = "← 返回大厅"

[node name="MatchInfo" type="Label" parent="Toolbar"]
layout_mode = 2
size_flags_horizontal = 3
text = "第 1 回合 · 规划"
theme_override_font_sizes/font_size = 20
vertical_alignment = 1

[node name="MatchClock" type="Label" parent="Toolbar"]
visible = false
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
text = "提交倒计时 30 秒"
theme_override_font_sizes/font_size = 18
horizontal_alignment = 2
vertical_alignment = 1
mouse_filter = 2

[node name="AiStatus" type="Label" parent="Toolbar"]
visible = false
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
text = ""
theme_override_font_sizes/font_size = 15
horizontal_alignment = 2
vertical_alignment = 1
mouse_filter = 2
theme_type_variation = &"MutedLabel"

[node name="SwitchSeat" type="Button" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"
text = "换边"

[node name="Restart" type="Button" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"
text = "重开"

[node name="SaveReplay" type="Button" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"
text = "保存回放"

[node name="Resync" type="Button" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"ToolButton"
text = "重新同步"

[node name="SaveDiagnostics" type="Button" parent="Toolbar"]
layout_mode = 2
